# =====================================================================
#  AURIX Video Studio – Server-Konfiguration
#  Kopiere diese Datei nach ".env" (wird NICHT ins Git übernommen) und
#  trage deine Schlüssel ein. Schlüssel bleiben ausschließlich auf dem Server.
# =====================================================================

# --- KI-Video-Anbieter (mindestens einen eintragen) ------------------
# fal.ai – empfohlen: ein Schlüssel für LTX-2, Wan 2.5, Kling 2.5, Veo 3.1
# Schlüssel erstellen: https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate – optionale Alternative: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Zugriffsschlüssel ----------------------------------------------
# Für ChatGPT (Custom GPT Action). Darf Aufträge NUR einreichen und lesen –
# niemals bestätigen/kostenpflichtig starten. Beliebige lange Zufallszeichenkette,
# z. B. erzeugen mit:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VIDEO_INTAKE_TOKEN=

# Für deine App (voller Zugriff inkl. Bestätigen). Leer lassen = nur direkte
# localhost-Verbindungen dürfen bestätigen. PFLICHT, sobald der Server öffentlich
# erreichbar ist. Denselben Wert dann in AURIX → Video Studio → Server eintragen.
VIDEO_APP_TOKEN=

# --- Kostenbremse (USD) ----------------------------------------------
MAX_COST_PER_JOB_USD=3
DAILY_BUDGET_USD=10

# --- Standardmodell (optional) ---------------------------------------
# ltx-2-fast | wan-2.5 | kling-2.5-turbo-pro | veo-3.1-fast | replicate-wan-2.2-fast | demo-motion
VIDEO_DEFAULT_MODEL=

# --- Server ----------------------------------------------------------
VIDEO_SERVER_HOST=127.0.0.1
VIDEO_SERVER_PORT=8787
# Öffentliche HTTPS-Adresse des Servers (für ChatGPT + Bild-zu-Video), z. B.
# https://aurix-video.onrender.com oder deine Tunnel-URL
PUBLIC_URL=
# Zusätzliche erlaubte Browser-Origins (z. B. deine GitHub-Pages-Adresse), kommagetrennt
VIDEO_CORS_ORIGINS=
# Speicherort der Videos (relativ zum Projekt)
VIDEO_STORAGE_DIR=server/storage
