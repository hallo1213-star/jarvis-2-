{
  "name": "valenheim-v2",
  "private": true,
  "version": "2.0.0-test",
  "description": "VALENHEIM – The City Challenge 2.0",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "install:all": "npm install --include=dev --prefix server && npm install --include=dev --prefix client",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/src/index.js",
    "test": "node --test server/test/*.test.js"
  }
}
